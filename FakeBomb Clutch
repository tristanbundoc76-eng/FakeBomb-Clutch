Instance.new("UICorner", bombBtn)

-- NOTIFY
local function notify(msg)
	StarterGui:SetCore("SendNotification", {
		Title = "FakeBomb",
		Text = msg,
		Duration = 2
	})
end

-- 💥 FLICK FUNCTION
local function flickCharacter(char)
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local original = hrp.CFrame

	for i = 1, 3 do
		hrp.CFrame = original * CFrame.Angles(0, math.rad(25), 0)
		task.wait(0.05)
		hrp.CFrame = original * CFrame.Angles(0, math.rad(-25), 0)
		task.wait(0.05)
	end

	hrp.CFrame = original
end

-- TOGGLE
toggle.MouseButton1Click:Connect(function()
	enabled = not enabled

	if enabled then
		toggle.BackgroundColor3 = Color3.fromRGB(0,170,0)
		toggle.Text = "FakeBomb: ON"
		bombBtn.Visible = true
	else
		toggle.BackgroundColor3 = Color3.fromRGB(80,80,80)
		toggle.Text = "FakeBomb: OFF"
		bombBtn.Visible = false
	end
end)

-- 💣 MAIN FUNCTION
local function useFakeBomb()
	if onCooldown then return end

	local char = player.Character
	if not char then return end

	local hum = char:FindFirstChild("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end

	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then
		notify("Equip FakeBomb!")
		return
	end

	if tool.Name ~= "FakeBomb" then
		notify("Wrong tool! Use FakeBomb")
		return
	end

	hum:UnequipTools()
	task.wait(0.1)

	-- 💣 fake drop
	local handle = tool:FindFirstChild("Handle")
	if handle then
		local fake = handle:Clone()
		fake.Parent = workspace
		fake.Anchored = true
		fake.CFrame = hrp.CFrame * CFrame.new(0, -3, 0)
		Debris:AddItem(fake, 3)
	end

	-- 💥 flick effect
	flickCharacter(char)

	-- jump reset
	hum:ChangeState(Enum.HumanoidStateType.Freefall)
	task.wait()
	hum:ChangeState(Enum.HumanoidStateType.Jumping)

	-- cooldown with button text
	onCooldown = true
	bombBtn.Active = false

	for i = COOLDOWN, 0, -1 do
		cdLabel.Text = "Cooldown: "..i.."s"
		bombBtn.Text = i.."s"
		task.wait(1)
	end

	cdLabel.Text = ""
	bombBtn.Text = "💣"
	bombBtn.Active = true
	onCooldown = false
end

-- BUTTON
bombBtn.MouseButton1Click:Connect(function()
	useFakeBomb()
end)

-- CLOSE
close.MouseButton1Click:Connect(function()
	frame.Visible = false
	bombBtn.Visible = false
	isOpen = false
	minimized = false
end)

-- MINIMIZE
minimize.MouseButton1Click:Connect(function()
	if not isOpen then return end

	minimized = not minimized

	if minimized then
		TweenService:Create(frame, TweenInfo.new(0.2), {
			Size = UDim2.new(0, 220, 0, 30)
		}):Play()
		toggle.Visible = false
		cdLabel.Visible = false
	else
		TweenService:Create(frame, TweenInfo.new(0.2), {
			Size = UDim2.new(0, 220, 0, 130)
		}):Play()
		task.wait(0.2)
		toggle.Visible = true
		cdLabel.Visible = true
	end
end)

-- RESET FIX
player.CharacterAdded:Connect(function()
	task.wait(1)
	frame.Visible = true
	bombBtn.Visible = enabled
	isOpen = true
	minimized = false
end)
